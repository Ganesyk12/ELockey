# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.
#
# The physical Postgres schema used by the ORM is selected via the `?schema=`
# query parameter. Leave it out to use the default `public` schema, or set it to
# any schema you provisioned (e.g. `?schema=elockey`) to keep your data out of a
# shared `public` schema.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=elockey"
PORT=5655

# Set to 1 when running behind a reverse proxy (nginx) so rate-limiting sees the
# real client IP. Keep empty/unset in plain local dev.
TRUST_PROXY=0

# Comma-separated list of allowed browser origins for CORS.
# Leave empty to deny cross-origin calls (same-origin via nginx proxy only).
# Example: ALLOWED_ORIGINS="https://elockey.votagers.or.id, https://dev.elockey.votagers.or.id"
ALLOWED_ORIGINS=